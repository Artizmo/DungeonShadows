{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"], // 👈 Changed from esnext to match your target
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext", // 👈 LEAVE THIS AS IS (Crucial for Vite)
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "~public/*": ["./public/*"],
      "~/types/*": ["src/@types/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "public/worker.js"],
  "exclude": ["node_modules"]
}
