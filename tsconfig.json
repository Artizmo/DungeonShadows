{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "./",
    "paths": {
      "~/*": ["src/*"],
      "~/types/*": ["src/@types/*"]
    }
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node"
  },
  "include": ["../**/*.ts", "../**/*.js"],
  "exclude": ["build"]
}