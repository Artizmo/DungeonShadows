{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler" /* 🟩 Changed from 'node' to support esnext configurations */,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "./",
    "paths": {
      "~/types/*": ["src/@types/*"] /* 🟩 Placed specific paths FIRST */,
      "~/*": ["src/*"]
    }
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node"
  },
  "include": ["src/**/*", "data/mock"],
  "exclude": ["node_modules", "build", "src/data/saved"]
}
