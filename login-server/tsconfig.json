{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~/shared/*": ["../shared/*"]
    }
  },
  "include": ["server.ts", "src/**/*", "data/mock", "../shared/**/*"],
  "exclude": ["node_modules", "src/data/saved"]
}
