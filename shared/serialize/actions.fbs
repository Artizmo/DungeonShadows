namespace GameProtocol;

// 1. Define the different payload tables
table MovePayload {
  w:bool;
  s:bool;
  a:bool;
  d:bool;
}

table AttackPayload {
  target_id:uint;
  skill_id:uint;
}

// 2. Wrap them in a Union
union ActionPayload {
  MovePayload,
  AttackPayload
}

// 3. Create the single Action wrapper
table ActionData {
  sequence_id:uint;
  payload:ActionPayload;
}

// 4. The Root Batch Packet
table ClientBatchPacket {
  actions:[ActionData]; // 🟢 The Vector batching all pending actions
}

root_type ClientBatchPacket;