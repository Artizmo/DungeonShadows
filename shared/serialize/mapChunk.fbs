namespace GameProtocol;

enum PacketType : byte {
  CharacterSpawn = 0,
  MapChunkData = 1,
  PlayerInput = 2
}

table MapChunk {
  x: int32;
  y: int32;

  // The raw WebP binary data payload cut from the server's memory cache
  image_bytes: [ubyte];

  // Optional expansion: if you want to include collision grids or tile IDs later
  // tile_data: [uint16];
}

// A wrapper packet that includes standard network headers
table MapChunkPacket {
  type: PacketType = MapChunkData;
  chunk: MapChunk;
}

root_type MapChunkPacket;