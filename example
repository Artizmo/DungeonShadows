    <script type="text/plain" id="typescript-code">
/**
 * TYPE DEFINITIONS
 */
interface GameConfig {
    readonly SPEED: number;
    readonly SERVER_TICK_RATE: number;
    readonly CLIENT_TICK_RATE: number;
    readonly INTERPOLATION_DELAY: number;
}

const GAME_CONFIG: GameConfig = {
    SPEED: 200,
    SERVER_TICK_RATE: 1000 / 20, // 20Hz
    CLIENT_TICK_RATE: 1000 / 60, // 60Hz fixed
    INTERPOLATION_DELAY: 100
};

enum ActionType {
    MOVE = 1,
    CAST = 2
}

interface ActionPayload {
    x?: number;
    y?: number;
    targetId?: string;
}

interface ActionRecord {
    sequenceId: number;
    type: ActionType;
    payload: ActionPayload;
    dt: number;
}

interface EntityState {
    x: number;
    y: number;
    mana: number;
    health: number;
    areaId: string | null;
    zoneId: string | null;
}

/* --- NETWORK DECOUPLING INTERFACES --- */

interface Snapshot {
    type: string;
    serverTime: number;
    entitiesDelta: Record<string, EntityState>;
    lastProcessedIds: Record<string, number>; // Maps character ID to their last processed sequence ID
}

interface NetworkEnvelope {
    connectionId: string;
    packet: ActionRecord;
}

interface ClientTransport {
    send(packet: ActionRecord): void;
    onReceive(handler: (snapshot: Snapshot) => void): void;
}

interface ServerTransport {
    broadcast(snapshot: Snapshot): void;
    onReceive(handler: (connectionId: string, packet: ActionRecord) => void): void;
}

/* ==========================================================================
   DOM CACHE (Massive Performance Optimization)
   Prevents querying the DOM 20+ times per frame during render loop
   ========================================================================== */
const DOM = {
    clientHpText: document.getElementById('ui-client-hp-text') as HTMLElement,
    clientHpBar: document.getElementById('ui-client-hp-bar') as HTMLElement,
