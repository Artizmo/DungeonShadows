{
  "compilerOptions": {
    "paths": {
      "public/*": ["../public/*"],
      "components/*": ["components/*"],
      "screens/*": ["screens/*"],
      "pages/*": ["pages/*"],
    },
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true, 
    "types" : ["node"]
  },  
  "exclude": [
    "node_modules",
    "public",
  ],
  "include": [
    "next.config.js"
  ]
}