## Step 2: The Network Update Brokerage

When a player moves or hits a switch, you don't broadcast the entire world data block over the wire. Instead, you stream lightweight **Delta Change Packets** using a network manager class.

```typescript
// Structural Packet Interfaces
export type GameServerPacket =
  | { type: 'ENTITY_MOVE'; payload: { entityId: string; from: Vector3D; to: Vector3D } }
  | { type: 'ROOM_DISCOVERED'; payload: { roomId: string } }
  | { type: 'LIGHT_STATE_CHANGE'; payload: { targetX: number; targetY: number; z: number; isActive: boolean } }
  | { type: 'WEATHER_CHANGE'; payload: { regionId: string; weather: 'NONE' | 'RAIN' | 'SNOW' | 'FOG' } };

export class NetworkBroker {
  // Broadcaster function filters packets by spatial visibility lines
  public broadcastToZone(zoneId: string, packet: GameServerPacket, activeConnections: any[]) {
    const serializedPacket = JSON.stringify(packet);

    for (const client of activeConnections) {
      if (client.currentZoneId === zoneId) {
        // Send down the pipe to valid local clients only
        client.socket.send(serializedPacket);
      }
    }
  }
}

