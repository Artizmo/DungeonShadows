{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "~/types/*": ["src/@types/*"],
      "~/*": ["src/*"],
      "~/shared/*": ["../shared/*"]
    }
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node"
  },
  "include": [
    "src/**/*",
    "data/mock",
    "../shared/**/*",
    "../client/src/core/_utils/inputBindings.ts",
    "../client/src/core/handlers",
    "../client/src/core/utils/input-dictionary.ts"
  ],
  "exclude": ["node_modules", "build", "src/data/saved"]
}
